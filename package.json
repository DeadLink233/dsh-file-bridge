{
  "name": "dsh-photo-bridge",
  "version": "1.1.0",
  "description": "Phone photo and file bridge for DSH: transfer photos or arbitrary files from a phone into the current conversation draft attachment bar over the local network.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/DeadLink233/dsh-photo-bridge.git"
  },
  "homepage": "https://github.com/DeadLink233/dsh-photo-bridge#readme",
  "bugs": {
    "url": "https://github.com/DeadLink233/dsh-photo-bridge/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "photo",
    "camera",
    "attachment",
    "lan",
    "file",
    "transfer",
    "phone"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "bridge.js",
    "client.js",
    "phone.html.js",
    "qr.js",
    "vendor",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
